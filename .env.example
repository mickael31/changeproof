# ─────────────────────────────────────
# ChangeProof AI — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────

# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/changeproof"

# NextAuth.js
AUTH_SECRET="votre-secret-auth-generer-avec-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth / SSO (optionnel)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_AZURE_AD_ID=""
AUTH_AZURE_AD_SECRET=""
AUTH_AZURE_AD_TENANT_ID=""

# SSO Auto-create org (true/false)
SSO_AUTO_CREATE_ORG="false"

# Stripe — Paiements et abonnements
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."

# URL publique de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_..."

# Arcjet (sécurité)
ARCJET_KEY="ajkey_..."
